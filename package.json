{
  "name": "our-little-world",
  "version": "0.1.0",
  "private": true,
  "description": "A calm cooperative browser world for two people to grow together.",
  "type": "module",
  "scripts": {
    "start": "node server/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "prettier --check . && eslint . && node --test tests/*.test.mjs",
    "fix": "prettier --write . && eslint . --fix",
    "verify": "node tools/verify.mjs",
    "deployed": "node tools/deployed.mjs",
    "build-id": "node server/buildid.mjs",
    "shipped": "node tools/shipped.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "playwright": "^1.56.1",
    "prettier": "^3.9.6"
  }
}
